# Client environment (Vite)

# Local: leave unset — Vite proxies `/api` to http://localhost:4000 (see vite.config.js).
# Production (optional): only if you call the Railway API directly from the browser
# instead of using the Vercel `/api` proxy. Prefer API_ORIGIN on Vercel (see server/DEPLOY_AUTH.md).
# VITE_API_URL=https://your-service.up.railway.app/api
