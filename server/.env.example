# Server environment — copy to server/.env for local development (never commit .env).

# PostgreSQL connection string. On Railway set it as a reference: ${{Postgres.DATABASE_URL}}
# Local: leave unset to use an embedded Postgres engine stored in server/.pgdata (dev/tests only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true only if your Postgres host requires TLS on the connection (not needed for Railway's private network).
# DATABASE_SSL=false

PORT=4000

# Production (Railway)
# NODE_ENV=production
# FRONTEND_URL=https://made-by-kseniya1.vercel.app
# TRUST_PROXY=2
# Only when the browser calls the Railway domain directly (VITE_API_URL) instead of the Vercel /api proxy:
# COOKIE_SAMESITE=none

# Email: sign-up codes, password reset and booking updates. Set these in Railway → Variables only, never in git or
# in Vercel. Exactly one provider sends: MAIL_PROVIDER=microsoft (Outlook) or resend. Without a ready provider,
# sign-up and password reset say email isn't available yet.
# MAIL_PROVIDER=

# Outlook through Microsoft Graph (MAIL_PROVIDER=microsoft). Values come from the Microsoft Entra app registration;
# the owner then connects the mailbox once from the profile page (no password or token is ever put in a variable).
# MAIL_FROM_NAME=
# MAIL_FROM_ADDRESS=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=consumers

# Resend (only when MAIL_PROVIDER=resend). RESEND_FROM_EMAIL must be on a domain verified in Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# Optional: signing secret of a Resend webhook pointed at <railway-domain>/api/webhooks/resend (delivered/bounced status).
# RESEND_WEBHOOK_SECRET=

# Public site address used for links, the logo in emails and the Microsoft redirect URI
# (<APP_PUBLIC_URL>/api/mail/microsoft/callback). Defaults to the first FRONTEND_URL.
# APP_PUBLIC_URL=https://made-by-kseniya1.vercel.app

# Optional: AI concierge chat
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
