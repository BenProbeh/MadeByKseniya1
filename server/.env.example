# Server environment — copy to server/.env for local development (never commit .env).

# PostgreSQL connection string. On Railway set it as a reference: ${{Postgres.DATABASE_URL}}
# Local: leave unset to use an embedded Postgres engine stored in server/.pgdata (dev/tests only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true only if your Postgres host requires TLS on the connection (not needed for Railway's private network).
# DATABASE_SSL=false

PORT=4000

# Production (Railway)
# NODE_ENV=production
# FRONTEND_URL=https://made-by-kseniya1.vercel.app
# TRUST_PROXY=2
# Only when the browser calls the Railway domain directly (VITE_API_URL) instead of the Vercel /api proxy:
# COOKIE_SAMESITE=none

# Email (Resend): sign-up codes, password reset and booking updates. Set these in Railway → Variables only,
# never in git or in Vercel. Without them sign-up and password reset say email isn't available yet.
# RESEND_FROM_EMAIL must be an address on a domain verified in Resend (Domains → DNS records).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=hello@your-verified-domain.com
# RESEND_FROM_NAME=MadeByKseniya
# Public site address used for links and the logo in emails (defaults to the first FRONTEND_URL).
# APP_PUBLIC_URL=https://made-by-kseniya1.vercel.app
# Optional: signing secret of a Resend webhook pointed at <railway-domain>/api/webhooks/resend (delivered/bounced status).
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# Optional: AI concierge chat
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
