# Server environment — copy to server/.env for local development (never commit .env).

# PostgreSQL connection string. On Railway set it as a reference: ${{Postgres.DATABASE_URL}}
# Local: leave unset to use an embedded Postgres engine stored in server/.pgdata (dev/tests only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true only if your Postgres host requires TLS on the connection (not needed for Railway's private network).
# DATABASE_SSL=false

PORT=4000

# Production (Railway)
# NODE_ENV=production
# FRONTEND_URL=https://made-by-kseniya1.vercel.app
# TRUST_PROXY=2
# Only when the browser calls the Railway domain directly (VITE_API_URL) instead of the Vercel /api proxy:
# COOKIE_SAMESITE=none

# Optional: AI concierge chat
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
